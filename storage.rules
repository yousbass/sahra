rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded files must be images under 10MB (deletes have no resource payload)
    function isValidImage() {
      return request.resource == null ||
             (request.resource.size < 10 * 1024 * 1024 &&
              request.resource.contentType.matches('image/.*'));
    }

    // Allow authenticated users to upload images only to their own folder
    match /camps/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isValidImage();
    }
    
    // Allow authenticated users to upload profile images only to their own folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isValidImage();
    }
  }
}
